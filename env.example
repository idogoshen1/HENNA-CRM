# Meta / WhatsApp
VERIFY_TOKEN=choose-a-long-random-string
META_APP_SECRET=replace_me
META_SYSTEM_USER_TOKEN=replace_me
META_GRAPH_VERSION=v26.0

# Railway automatically provides DATABASE_URL when Postgres is linked.
DATABASE_URL=

# Protect CRM API endpoints
ADMIN_API_KEY=choose-another-long-random-secret

# CRM defaults
TIMEZONE=Asia/Jerusalem
NEW_CONVERSATION_AFTER_HOURS=24
DEFAULT_OWNER=מעיין
DEFAULT_PRIORITY=בינונית
